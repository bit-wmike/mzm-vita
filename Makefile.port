# Metroid: Zero Mission - host / PS Vita port build.
#
#   make -f Makefile.port TARGET=host     32-bit Linux headless test build
#   make -f Makefile.port TARGET=vita     PS Vita build (needs $VITASDK)
#
# Before the first build, extract the game data from your own ROM:
#   cp <your EU ROM> mzm_eu_baserom.gba && python3 tools/extractor.py -r eu

TARGET ?= host
REGION ?= eu
BUILD := build/port-$(TARGET)
GEN := build/port-gen-$(REGION)

PYTHON ?= python3
ARM_AS ?= arm-none-eabi-as
ARM_OBJDUMP ?= arm-none-eabi-objdump

REGION_DEF := -DREGION_$(shell echo $(REGION) | tr a-z A-Z)

ifeq ($(TARGET),host)
CC := gcc
ARCHFLAGS := -m32 -fno-pie -no-pie -malign-data=abi
OPT ?= -O2 -g
LDLIBS := -lm -rdynamic
PLATFORM_SRC := $(wildcard platform/host/*.c)
OUT := $(BUILD)/mzm_host
else ifeq ($(TARGET),armhost)
# The headless runner built for 32-bit ARMv7 hard-float like the Vita and run
# under qemu-arm, linked at the Vita's address range: catches ARM-only
# differences (unsigned char, code generation, high addresses).
CC := arm-linux-gnueabihf-gcc
ARCHFLAGS := -march=armv7-a -mtune=cortex-a9 -mfpu=neon -mfloat-abi=hard -mthumb
OPT ?= -O2 -g
LDLIBS := -lm -static -Wl,-Ttext-segment=0x81000000
PLATFORM_SRC := $(wildcard platform/host/*.c)
OUT := $(BUILD)/mzm_armhost
else ifeq ($(TARGET),vita)
VITASDK ?= /usr/local/vitasdk
CC := $(VITASDK)/bin/arm-vita-eabi-gcc
ARCHFLAGS := -march=armv7-a -mtune=cortex-a9 -mfpu=neon -mfloat-abi=hard -mthumb
OPT ?= -O2 -g -ffunction-sections -fdata-sections
LDLIBS := -Wl,-q -Wl,--gc-sections -lvita2d -lSceDisplay_stub -lSceCtrl_stub -lSceTouch_stub -lSceAudio_stub \
          -lScePower_stub -lSceAppUtil_stub -lSceAppMgr_stub -lSceSysmodule_stub \
          -lSceCommonDialog_stub -lSceGxm_stub -lScePgf_stub -lpthread -lm
PLATFORM_SRC := $(wildcard platform/vita/source/*.c)
OUT := $(BUILD)/mzm_vita.elf
# GCC 14+ turns these old-C leniencies of the decomp into errors.
EXTRA_CFLAGS := -Wno-error=implicit-function-declaration -Wno-error=implicit-int \
                -Wno-error=incompatible-pointer-types -Wno-error=int-conversion -Wno-error=return-mismatch
endif

VERSION := $(shell cat platform/vita/VERSION)

CPPFLAGS := -DPORT -DMZM_PORT_VERSION=\"$(VERSION)\" $(REGION_DEF) -Iinclude -I. -Iport/ppu/include
CFLAGS := $(ARCHFLAGS) $(OPT) -std=gnu11 -fno-strict-aliasing -fwrapv -fno-common -fno-toplevel-reorder -w $(EXTRA_CFLAGS)

GAME_SRC := $(filter-out src/dma.c src/multiboot.c,$(shell find src -name '*.c' | sort))
PORT_SRC := $(wildcard port/*.c) port/ppu/src/mode1.c port/ppu/src/virtuappu.c

GAME_OBJ := $(patsubst %.c,$(BUILD)/%.o,$(GAME_SRC))
PORT_OBJ := $(patsubst %.c,$(BUILD)/%.o,$(PORT_SRC) $(PLATFORM_SRC))
GEN_OBJ := $(BUILD)/gen/asm_gen.o $(BUILD)/gen/sound_relocs.o $(BUILD)/gen/sound_blobs.o $(BUILD)/gen/assets_list.o

all: $(OUT)

$(OUT): $(GAME_OBJ) $(PORT_OBJ) $(GEN_OBJ)
	$(CC) $(ARCHFLAGS) -o $@ $^ $(LDLIBS)

# Game sources go through the decomp's text preprocessor first, then the port's
# asset step, which replaces the data extracted from the ROM by run-time loading.
$(BUILD)/src/%.o: src/%.c tools/port/pp_assets.py
	@mkdir -p $(dir $@)
	@$(PYTHON) tools/preproc.py $< charmap.txt > $(BUILD)/src/$*.pp0.c
	@$(PYTHON) tools/port/pp_assets.py $(BUILD)/src/$*.pp0.c $(BUILD)/src/$*.pp.c PortAssets_$(subst /,_,$(subst .,_,$*)) --region $(REGION)
	$(CC) $(CPPFLAGS) -iquote $(dir $<) $(CFLAGS) -c $(BUILD)/src/$*.pp.c -o $@

# Calls the asset registration of every game source file.
$(BUILD)/gen/assets_list.c: Makefile.port
	@mkdir -p $(dir $@)
	@( echo '/* Generated by Makefile.port */'; \
	   for f in $(patsubst src/%.c,%,$(GAME_SRC)); do echo "void PortAssets_$$(echo $$f | tr '/.' '__')(void);"; done; \
	   echo 'void PortAssets_Sound(void);'; \
	   echo 'void PortAssets_RegisterAll(void)'; echo '{'; \
	   for f in $(patsubst src/%.c,%,$(GAME_SRC)); do echo "    PortAssets_$$(echo $$f | tr '/.' '__')();"; done; \
	   echo '    PortAssets_Sound();'; echo '}' ) > $@
$(BUILD)/gen/assets_list.o: $(BUILD)/gen/assets_list.c
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

# Hand-written ARM code of the sound engine, translated to C.
$(GEN)/audio_internal.o: asm/audio_internal.s
	@mkdir -p $(GEN)
	$(ARM_AS) -mcpu=arm7tdmi --defsym REGION_$(shell echo $(REGION) | tr a-z A-Z)=1 -I. $< -o $@
$(GEN)/soundcode.o: asm/soundcode.s
	@mkdir -p $(GEN)
	$(ARM_AS) -mcpu=arm7tdmi --defsym REGION_$(shell echo $(REGION) | tr a-z A-Z)=1 -I. $< -o $@
$(GEN)/asm_gen.c: $(GEN)/audio_internal.o $(GEN)/soundcode.o tools/port/asm2c.py
	$(PYTHON) tools/port/asm2c.py --objdump $(ARM_OBJDUMP) --out $@ \
		asm/audio_internal.s=$(GEN)/audio_internal.o asm/soundcode.s=$(GEN)/soundcode.o

# Sound data (tracks, voice groups, samples).
$(GEN)/sound_blobs.s $(GEN)/sound_relocs.c: tools/port/gen_sound.py $(wildcard sound/*.s)
	@mkdir -p $(GEN)
	$(PYTHON) tools/port/gen_sound.py --out $(GEN) --region $(REGION) --as $(ARM_AS)

$(BUILD)/gen/asm_gen.o: $(GEN)/asm_gen.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
$(BUILD)/gen/sound_relocs.o: $(GEN)/sound_relocs.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
$(BUILD)/gen/sound_blobs.o: $(GEN)/sound_blobs.s
	@mkdir -p $(dir $@)
	$(CC) $(ARCHFLAGS) -c $< -o $@

# The software renderer is the hot path: optimised harder.
$(BUILD)/port/ppu/%.o: port/ppu/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -O3 -c $< -o $@

# ---- PS Vita package ----
TITLE_ID := MZMV00001
TITLE := Zero Mission
VPK := $(BUILD)/ZeroMission_Vita_$(VERSION).vpk
SCE := platform/vita/sce_sys

vpk: $(VPK)

$(VPK): $(OUT) $(SCE)/icon0.png $(SCE)/livearea/contents/bg.png $(SCE)/livearea/contents/startup.png $(SCE)/livearea/contents/template.xml platform/vita/VERSION
	$(VITASDK)/bin/vita-elf-create $(OUT) $(BUILD)/mzm.velf
	$(VITASDK)/bin/vita-make-fself -s -c $(BUILD)/mzm.velf $(BUILD)/eboot.bin
	$(VITASDK)/bin/vita-mksfoex -s TITLE_ID=$(TITLE_ID) -s APP_VER=01.00 -d ATTRIBUTE2=12 "$(TITLE)" $(BUILD)/param.sfo
	$(VITASDK)/bin/vita-pack-vpk -s $(BUILD)/param.sfo -b $(BUILD)/eboot.bin \
	    -a $(SCE)/icon0.png=sce_sys/icon0.png \
	    -a $(SCE)/livearea/contents/bg.png=sce_sys/livearea/contents/bg.png \
	    -a $(SCE)/livearea/contents/startup.png=sce_sys/livearea/contents/startup.png \
	    -a $(SCE)/livearea/contents/template.xml=sce_sys/livearea/contents/template.xml \
	    $@
	cp $(OUT) $(BUILD)/mzm_vita-$(VERSION).elf

clean:
	rm -rf $(BUILD) $(GEN)

.PHONY: all clean vpk
